name: Build CamelClone Plugin

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Check out this project
        uses: actions/checkout@v4

      - name: Clone JUCE
        run: git clone --depth 1 https://github.com/juce-framework/JUCE.git

      - name: Configure
        run: cmake -B build -G Xcode

      - name: Build (Release)
        run: cmake --build build --config Release

      - name: Quick DSP sanity check
        run: |
          g++ -std=c++17 -O2 -Wall -Wextra -o test_dsp test_dsp.cpp
          ./test_dsp

      - name: Upload built plugin
        uses: actions/upload-artifact@v4
        with:
          name: CamelClone-macOS-arm64
          path: |
            build/CamelClone_artefacts/Release/VST3
            build/CamelClone_artefacts/Release/AU
            build/CamelClone_artefacts/Release/Standalone
          if-no-files-found: error
